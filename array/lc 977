class Solution {
    public int[] sortedSquares(int[] nums) {
        int n=nums.length;
        int left=0;
        int right=n-1;
        int leftSq;
        int rightSq;
        int[] arr=new int[n];
        int index=n-1;
        
        while (left<=right){
            leftSq = nums[left] * nums[left];
            rightSq = nums[right] * nums[right];

            if (leftSq>rightSq){
                arr[index]=leftSq;
                left++;
            }
            else if (leftSq<rightSq){
                arr[index]=rightSq;
                right--;

            }
            index--;
        }
        return arr;
    }
}
