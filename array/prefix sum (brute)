
public class Main
{
	public static void main(String[] args) {
		System.out.println("Hello World");
		int[] arr ={1,3,4,5,15};
		int n=arr.length;
		int sum=0;
		int[] num=new int [n];
		for (int i=0;i<n;i++){
		    for (int j=i;j<i+1;j++){
		        sum+=arr[j];
		    }
		    num[i]=sum;
		}
		for (int i=0;i<n;i++){
		    System.out.println(num[i]);
		}
	}
}
