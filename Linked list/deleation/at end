public class Main
{
	public static void main(String[] args) {
	    Node head=new Node(10);
	    head.next=new Node(20);
	    head.next.next=new Node(30);
	    
	   if (head==null){
	       return;
	   }
	   else if (head.next==null){
	       head=null;
	       return;
	   }
	   
	   Node temp=head;
	   while (temp.next.next!=null){
	       temp=temp.next;
	   }
	   temp.next=null;
	 
	    temp=head;
	    while (temp!=null){
	        System.out.println(temp.data);
	        temp=temp.next;
	    }
	    
		
	}
}
class Node{
    int data;
    Node next;
    
    Node (int data){
        this.data=data;
        this.next=null;
    }
}
